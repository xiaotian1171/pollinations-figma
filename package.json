{
  "name": "pollinations-figma",
  "version": "1.0.0",
  "description": "Generate and edit images with Pollinations inside Figma, paying with your own Pollen.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
