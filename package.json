    "test:live": "node build.mjs --tests && node build/tests.js --live"
  },
  "license": "MIT",
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.2",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
